# Copy to .env for local work. Every value here is a default or a local-only
# credential — never put a real secret in this file, it is tracked in git.
#
# docker compose sets these itself, so this is for running the binary directly
# against a Postgres you started with `make up`.

# --- Required ---------------------------------------------------------------
DATABASE_URL=postgres://stockwatch:stockwatch@localhost:5432/stockwatch?sslmode=disable

# --- Server -----------------------------------------------------------------
ADDR=:8080
REQUEST_TIMEOUT=10s
# Must exceed REQUEST_TIMEOUT, or the server severs the connection before a slow
# handler can report its own timeout. Startup refuses to proceed otherwise.
WRITE_TIMEOUT=15s
READ_TIMEOUT=10s
IDLE_TIMEOUT=60s
# Should exceed REQUEST_TIMEOUT so in-flight requests can finish during a drain.
SHUTDOWN_TIMEOUT=20s
MAX_BODY_BYTES=1048576

# --- Connection pool --------------------------------------------------------
# Sized against the database, not guessed: replicas x DB_MAX_CONNS must leave
# headroom under Postgres's max_connections for migrations and psql sessions.
DB_MAX_CONNS=10
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_HEALTH_CHECK_PERIOD=1m

# --- Demand model -----------------------------------------------------------
# Days of sales history used to estimate demand. Must be at least 7 so the
# window covers a full weekly cycle.
HISTORY_WINDOW_DAYS=28
# Exponential smoothing factor, in (0, 1]. Higher reacts faster to change and is
# noisier; 0.10 gives an effective half-life of roughly a week.
DEMAND_ALPHA=0.10

# --- Logging ----------------------------------------------------------------
# debug | info | warn | error
LOG_LEVEL=info
# json for collectors, text for reading by eye
LOG_FORMAT=json
